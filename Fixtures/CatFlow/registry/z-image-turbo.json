{
  "id": "Tongyi-MAI/Z-Image-Turbo",
  "display": "Z-Image Turbo",
  "kind": "local",
  "engine": "mlx-diffusion",
  "tasks": [
    "Generate Image",
    "Edit Image",
    "Init Latent",
    "Encode Latent",
    "Decode Latent",
    "Denoise"
  ],
  "settings": {
    "steps": {
      "type": "number",
      "min": 1,
      "max": 50,
      "default": 9,
      "maps_to": "num_inference_steps"
    },
    "width": {
      "type": "number",
      "min": 256,
      "max": 2048,
      "default": 1024
    },
    "height": {
      "type": "number",
      "min": 256,
      "max": 2048,
      "default": 1024
    },
    "seed": {
      "type": "number",
      "min": 0,
      "max": 4294967295,
      "maps_to": "seed",
      "auto_ok": true
    },
    "strength": {
      "type": "number",
      "min": 0.0,
      "max": 1.0,
      "default": 0.5,
      "maps_to": "image_strength"
    },
    "quantize": {
      "type": "number",
      "min": 3,
      "max": 8,
      "default": 8,
      "maps_to": "quantize"
    },
    "lora": {
      "type": "adapter",
      "adapter_kind": "lora",
      "repeatable": true,
      "weight_range": [
        0.0,
        2.5
      ]
    },
    "preview": {
      "type": "bool",
      "default": false,
      "maps_to": "preview"
    }
  },
  "capabilities": {
    "supports_guidance": false,
    "variant": "z-image-turbo",
    "latent_space": "flux-1",
    "rejected_settings": {
      "guidance": "timestep-distilled, no CFG",
      "negative": "no classifier-free guidance"
    }
  },
  "resources": {
    "disk_gb": 12.0,
    "ram_gb": 7.0,
    "bits": 8
  },
  "source": "https://huggingface.co/Tongyi-MAI/Z-Image-Turbo",
  "checksum": "N/A",
  "license": "Apache-2.0",
  "manifest_version": 1,
  "pinned": false
}
