// Direct.xcconfig
// Direct-download edition: Developer ID signed + notarized, NOT sandboxed,
// ships the shell / filesystem / subprocess tools.
// Target: MLXUI-Direct   Product: "AI Browser Pro.app"

#include "Shared.xcconfig"

PRODUCT_NAME = MLXUI Pro
PRODUCT_BUNDLE_IDENTIFIER = net.connectcode.mlxui-pro
// TODO(dual-distribution.md §5): ship a distinct "AppIcon-Direct" set so the two
// editions don't have identical Dock icons when installed side by side. Until that
// art exists, both editions use the one "AppIcon" set in MLXUI/Assets.xcassets —
// naming a missing set here just fails the asset-catalog compile.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ── No sandbox; Hardened Runtime only (required for notarization) ──
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = MLXUI/MLXUI-Direct.entitlements

// ── Signing ──
// Signing stays fully automatic (Apple Development) for every plain build and
// archive of this target. The Developer ID Application identity is applied
// afterwards by `xcodebuild -exportArchive` with Config/ExportOptions-Direct.plist
// (method = developer-id, signingStyle = automatic) — see dual-distribution.md §7.
//
// Do NOT pin `CODE_SIGN_IDENTITY = Developer ID Application` here: with
// CODE_SIGN_STYLE = Automatic (Shared.xcconfig) that produces Xcode's
// "conflicting provisioning settings" error, because automatic signing only
// provisions Apple Development for a non-export build. The export step is where
// the distribution identity belongs.

// ── Feature flags ──
// DIRECT_BUILD compiles in ProcessShell + the shell/file agent tools. The
// App Store target never sees these files (target membership) and never
// evaluates this flag, so the sandboxed binary cannot contain them.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DIRECT_BUILD

// ── TCC purpose strings ──
// Without the sandbox, reading these locations still triggers a consent prompt.
// The prompt shows these strings; with no string, macOS silently denies on
// some releases. Full Disk Access cannot be entitled — the user grants it in
// System Settings > Privacy & Security.
INFOPLIST_KEY_NSDocumentsFolderUsageDescription = MLXUI Pro needs access to your Documents folder so local models and agent tools can read and write files you point them at.
INFOPLIST_KEY_NSDesktopFolderUsageDescription = MLXUI Pro needs access to your Desktop so local models and agent tools can read and write files you point them at.
INFOPLIST_KEY_NSDownloadsFolderUsageDescription = MLXUI Pro needs access to your Downloads folder so local models and agent tools can read and write files you point them at.
INFOPLIST_KEY_NSRemovableVolumesUsageDescription = MLXUI Pro needs access to removable volumes so you can keep model weights on an external drive.
